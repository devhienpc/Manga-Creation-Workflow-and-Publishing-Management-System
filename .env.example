# ============================================================
#  .env.example — Template cấu hình môi trường
# ============================================================
# Sao chép file này thành .env rồi điền giá trị thực vào.
# File .env.example ĐƯỢC PHÉP commit lên Git (không có giá trị thực).
# File .env TUYỆT ĐỐI KHÔNG commit (đã được liệt kê trong .gitignore).

# ── Cơ sở dữ liệu ────────────────────────────────────────
DB_HOST=localhost
DB_NAME=manga_system
DB_USER=root
DB_PASS=

# ── API Keys ──────────────────────────────────────────────
# Google Gemini (AI Phân Đoạn): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face (AI Tô màu): https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
